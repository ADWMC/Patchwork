{
  "name": "@patchwork/coding-agent",
  "version": "1.0.0",
  "description": "Maintainable coding agent for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADWMC/Patchwork.git"
  },
  "homepage": "https://github.com/ADWMC/Patchwork#readme",
  "bugs": {
    "url": "https://github.com/ADWMC/Patchwork/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./runtime": "./src/runtime.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/changelog-guide.md",
    "docs/changelog-research-2026-10-30.md",
    "docs/information-retrieval-research-2026-10-31.md",
    "docs/information-retrieval-execution-plan-2026-10-31.md",
    "docs/remaining-plans-execution-roadmap-2026-10-31.md",
    "docs/improvement-execution-2026-10-31.md",
    "docs/benchmark-research-2026-10-31.md",
    "docs/web-ui-skill-community-review-2026-10-31.md",
    "docs/human-centered-ai-ui-research-2026-10-31.md",
    "docs/skill-reliability-audit-2026-10-31.md",
    "docs/skills-fusion-plan-2026-10-31.md",
    "docs/skills-fusion-execution-2026-10-31.md",
    "benchmarks/coding",
    "benchmarks/patchwork",
    "assets/prompts/retrieval-research-prompt.md",
    "src",
    "lib",
    "hooks",
    "presets",
    "profiles",
    "scripts",
    "tests/fixtures/dsh-v0.2.1-rc.2.standard.patch.yml",
    "tests/fixtures/dsh-v0.2.1-rc.5.standard.patch.yml",
    "tests/fixtures/dsh-v0.2.2-alpha.3.standard.patch.yml",
    "assets",
    "cordis.patch.yml",
    "docs/browser-optional-package-2026-11-01.md",
    "docs/browser-runtime-integration-2026-11-01.md",
    "docs/checks/browser-optional-package-2026-11-01.json",
    "docs/browser-chrome-2026-11-01.md",
    "docs/superagent-fusion-2026-11-01.md",
    "docs/superagent-native-2026-11-01.md",
    "docs/superagent-prompt-optimization-2026-11-01.md",
    "docs/checks/superagent-prompt-optimization-2026-11-01.json",
    "docs/system-prompts-community-research-2026-11-01.md",
    "docs/checks/system-prompts-community-2026-11-01.json",
    "docs/checks/superagent-native-2026-11-01.json",
    "docs/checks/superagent-fusion-2026-11-01.json",
    "docs/checks/browser-chrome-2026-11-01.json",
    "docs/dsh-multi-version-2026-11-04.md",
    "docs/checks/dsh-compat-2026-11-04.json",
    "docs/closure-2026-11-01.md",
    "docs/memory-management-2026-11-01.md",
    "docs/ui-community-expansion-2026-11-01.md",
    "docs/checks/ui-community-expansion-2026-11-01.json",
    "docs/checks/closure-2026-11-01.json",
    "docs/archive/removed-evidence.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:release": "node scripts/check-browser-release.mjs",
    "pack:local": "node scripts/publish.mjs",
    "verify:improvement-real": "node scripts/verify-improvement-isolation.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"tests/real-composition/*.test.mjs\" \"packages/browser/tests/*.test.mjs\"",
    "test:benchmark": "node benchmarks/coding/run-isolated.mjs --mode=oracle",
    "check:docs": "node scripts/check-doc-links.mjs",
    "dsh:version": "node scripts/set-dsh-version.mjs",
    "test:acceptance:ui": "node tests/ui.acceptance.mjs",
    "test:acceptance:browser": "node packages/browser/tests/interaction.acceptance.mjs",
    "test:acceptance:native": "node packages/browser/tests/native-browser.acceptance.mjs",
    "audit:report": "node scripts/real-model-audit.mjs",
    "audit:verify": "node scripts/verify-real-model-audit.mjs",
    "verify:closure": "node scripts/verify-closure.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/patchwork.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-pwsh-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-log-export": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell-env": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "esbuild": "^0.28.2"
  }
}
